# Copy to .env.local and fill in. Never commit .env.local.

# Backend (AI_bookmarkManager_api). Locally: uvicorn app.main:app --reload --port 8000
# Leave empty to use the built-in JSON-file user store (development only; no Google sign-in or password reset).
AUTH_API_URL=http://localhost:8000

# Google OAuth client id (public value). The client SECRET lives only in the API's .env.
GOOGLE_CLIENT_ID=
# Callback registered on the Google client and in the API's GOOGLE_REDIRECT_URIS.
# Default: <this site's origin>/api/auth/google/callback — set it explicitly in production.
# GOOGLE_REDIRECT_URI=https://tidypin.com/api/auth/google/callback

# Shared secret with the API (same value as INTERNAL_API_KEY there): forwards the visitor's IP for rate limits.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Required in production when AUTH_API_URL is empty (signs built-in sessions)
# AUTH_SECRET=
# Public site URL. Also used for PayPal's return URL (/billing/return) — must be listed in the API's WEB_URL.
# NEXT_PUBLIC_SITE_URL=https://tidypin.com
